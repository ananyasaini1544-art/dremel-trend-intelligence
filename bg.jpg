1ef9d4f1e2.jpg?imgWidth=1474\u0026imgHeight=830\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=2211\u0026imgHeight=1245\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=2948\u0026imgHeight=1660\u0026scale=1","aspectRatio":"DEFAULT"},"imageSetXs":{"x1":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=415\u0026imgHeight=234\u0026scale=1","x2":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=830\u0026imgHeight=468\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1245\u0026imgHeight=702\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1660\u0026imgHeight=936\u0026scale=1","aspectRatio":"DEFAULT"},"imageSetXsm":{"x1":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=737\u0026imgHeight=415\u0026scale=1","x2":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1474\u0026imgHeight=830\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=2211\u0026imgHeight=1245\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=2948\u0026imgHeight=1660\u0026scale=1","aspectRatio":"DEFAULT"},"imageSetSm":{"x1":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=300\u0026imgHeight=169\u0026scale=1","x2":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=600\u0026imgHeight=338\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=900\u0026imgHeight=507\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1200\u0026imgHeight=676\u0026scale=1","aspectRatio":"DEFAULT"},"imageSetMd":{"x1":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=360\u0026imgHeight=202\u0026scale=1","x2":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=720\u0026imgHeight=404\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1080\u0026imgHeight=606\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1440\u0026imgHeight=808\u0026scale=1","aspectRatio":"DEFAULT"},"imageSetLg":{"x1":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=360\u0026imgHeight=202\u0026scale=1","x2":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=720\u0026imgHeight=404\u0026scale=1","x3":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1080\u0026imgHeight=606\u0026scale=1","x4":"https://www.dremel.com/images/jumbotron-creative--6d8b9a7990be4699b861f51ef9d4f1e2.jpg?imgWidth=1440\u0026imgHeight=808\u0026scale=1","aspectRatio":"DEFAULT"}},"type":"image"},"titleAlignment":"left","descriptionAlignment":"left","labelAlignment":"left","campaignTracking":{"business_unit":"RT","division":"PT","brand_name":"Dremel","language":"en","page_country":"US","site_domain_type":"prod","product_brand":["Dremel"],"tealium_event":"PT_TeaserCTA_Click","click_target_type":"onsite","click_target_url_host":"https://www.dremel.com/","page_breadcrumb":["Home","Rotary"],"page_name":"content:Rotary","page_type":"content","page_subcategory1":"Home","page_subcategory2":"Rotary","click_name":"\u003cstrong\u003eCreative Projects\u003c/strong\u003e","click_target_url":"https://www.dremel.com/us/en/ro