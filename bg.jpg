ight_item__gh_dS Copyright_privacySettings__2zg33" data-qa="Privacy settings"><button class="Copyright_link__87_k_" data-show-privacy-settings="true" type="button">Privacy settings<svg class="Icon_icon__Y_3O7" height="24" width="24"><use xlink:href="/assets/images/icons/icons.svg#privacy-options"></use></svg></button></li></ul><div class="Copyright_copyrightLabel___NBvR">© ROBERT BOSCH TOOL CORPORATION 2022, ALL RIGHTS RESERVED.</div></div></footer></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"page":{"meta":{"product":"brxm","version":"1.0","branch":"master"},"links":{"self":{"href":"https://www.dremel.com/us/en/resourceapi/rotary","type":"external"},"site":{"href":"/rotary/index","type":"internal"}},"channel":{"info":{"props":{"cliplister_customer_id":"157140","tracking_profile":"us-pt-rt-oneux-web","playstore_id":"","commerce_connector_baseUrl":"https://api.commerce-connector.com/REST/2.0/OnlineShop","commerce_connector_subId":"dremel_oneux_powertools","itunesapp_id":"","mybosch_signin_style_id":"824b31e7-3a2d-4105-a589-267346441cdf","commerce_connector_hideDeliveryInfo":"","commerce_connector_token":"48685e3b0e3ed4e3f616d10e92160a87beb8faed"}}},"root":{"$ref":"/page/u04b68f7b66ef45028901e651b25cce99"},"document":{"$ref":"/page/u43f9e9f286c04158a81a34d303712a85"},"page":{"u04b68f7b66ef45028901e651b25cce99":{"meta":{"definitionId":"hst:pages/editorial.generic"},"name":"editorial.generic","type":"component","children":[{"$ref":"/page/u486aa8c3f3c649b494ec8aea64782a93"},{"$ref":"/page/ub4f95ee0dbaf486ca9b4c82c1475a61e"},{"$ref":"/page/u535eb341c3324a3cbceaeb0983b45e2d"},{"$ref":"/page/u678b8ffa6ae14eb3a439071a1adee4ea"},{"$ref":"/page/ubc699fd994e24e908d3986febcd409eb"},{"$ref":"/page/u9845934cdbd7415ba20f4d9314025999"},{"$ref":"/page/u407926639c964fce9c74360bd8b04718"},{"$ref":"/page/uf26aee52d0ad46d99ad9e3ee4dbe32bd"},{"$ref":"/page/u9f4fa02f7ae04573965faa1ecde3ed78"}],"models":{"compress":false,"arabic":false,"showOnlyBody":false,"pagelanguage":"en-US"},"statusCode":200},"ub4f95ee0dbaf486ca9b4c82c1475a61e":{"meta":{},"name":"pagehead","type":"component","children":[{"$ref":"/page/ud1edd331cff043e08abf5c8b3cf1b5dc"},{"$ref":"/page/u3bac940aeebc4616b2368b82dac479b8"},{"$ref":"/page/u48f042becace42879f74f66d317d35f3"},{"$ref":"/page/u3b0c03c757c04539bbbb6b3e3f9aba72"},{"$ref":"/page/u61b940e7630b43ddbab202e2960f951a"},{"$ref":"/page/uf7ae362cc32043dabe29dfccd2a0c7d4"},{"$ref":"/page/uef83263e599c46738ecff09efb3c4abe"},{"$ref":"/page/ue088d1cc267746a4a4611c08c5402979"},{"$ref":"/page/u81b4c29ce51d43d9a5dfda74dbc97305"},{"$ref":"/page/ue172b551306a47c4880b9b560e698779"},{"$ref":"/page/ud1465874409b4f8a988a6e92c3d82cda"},{"$ref":"/page/u29322a457d0f4ac696eb32922b5cb40f"}]},"u535eb341c3324a3cbceaeb0983b45e2d":{"meta":{},"name":"main","type":"component","children":[{"$ref":"/page/u033fc0afcdea4de2b9dd8962d7b9e490"}],"models":{"legalNotices":[]}},"u486aa8c3f3c649b494ec8aea64782a93":{"meta":{},"name":"header","type":"component","children":[{"$ref":"/page/ue3623620a0bb402c9aefb75b62c88ddb"},{"$ref":"/page/ua9e45f2117234d70b871e24bf94e21c4"},{"$ref":"/page/u0e174b5c555d497ba4bc58137ea9b8cb"},{"$ref":"/page/u58f08353f26741e4a070ef513973d2a8"},{"$ref":"/page/u0376efcda295486192aec94fc7324e84"},{"$ref":"/page/ue1c605ddc8164bf5abb9346b2ab71d8f"},{"$ref":"/page/uac9269cecd1142d69ba0432ca2e8e51b"}],"models":{"homepageName":""}},"u678b8ffa6ae14eb3a439071a1adee4ea":{"meta":{},"name":"jsonld","type":"component","models":{"jsonLDModel":"[{\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@id\":\"https://www.dremel.com/us/en/resourceapi\",\"name\":\"Home\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@id\":\"https://www.dremel.com/us/en/rotary\",\"name\":\"Rotary\"}}],\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\"},{\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is a Rotary-Tool used for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eA Rotary-Tool is one of the most versatile tools you can own. With the right accessories, it can cut, sand, grind, polish, engrave, carve, clean, and detail across wood, metal, plastic, glass, tile, and more. All with a single compact tool.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why would I choose a Rotary-Tool instead of multiple single-use tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eBecause one Rotary-Tool can replace several specialty tools. Instead of buying, storing, and switching between tools, a Rotary-Tool adapts to the job through interchangeable accessories, saving space, money, and time.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Is a Rotary-Tool worth owning if I’m not a “serious DIYer”?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eAbsolutely. Rotary-Tools are designed for everyday fixes, creative projects, and home upgrades. Whether you are hanging decor, repairing furniture, or personalizing a gift, a Rotary-Tool makes projects easier and more approachable, even for first time users.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"What makes Dremel different from other Rotary-Tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eDremel invented the Rotary-Tool category and has spent nearly 90 years refining it. From performance and durability to accessory compatibility and innovation, Dremel tools are the benchmark others are measured against.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Are Dremel Rotary-Tools compatible with different attachments and accessories?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eYes. Dremel offers one of the largest ecosystems of Rotary-Tool attachments and accessories available. That means your tool grows with your projects, from basic DIY to advanced craftsmanship, without needing to replace the tool itself.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why is Dremel often more expensive than other Rotary-Tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eBecause performance, durability, and reliability matter. Dremel tools are engineered to last, backed by decades of expertise, tested rigorously, and designed to perform consistently across projects where precision and control count.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Are Dremel Rotary-Tools easy to use for beginners?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eYes. Dremel tools are designed with intuitive controls, comfortable grips, and balanced weight to help users feel confident right away. Many models include speed controls and guided accessories so you can learn as you go.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Can a Rotary-Tool handle both delicate detail work and tougher jobs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eYes. Rotary-Tools are uniquely suited for both fine detail tasks like engraving and heavier jobs like cutting or grinding. Different speeds, accessories, and tool series let you dial in the right level of control or power for each task.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Corded or cordless which is better?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eIt depends on how you work. Corded tools offer consistent power for longer sessions, while cordless tools give you mobility and freedom. Dremel offers both, so you do not have to compromise. You can choose what fits your projects best.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Which Dremel Rotary-Tool is right for me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eSignature Series\\u003cbr /\\u003e\\nBest for everyday DIY and versatility\\u003c/p\\u003e\\n\\n\\u003cp\\u003ePrecision Series\\u003cbr /\\u003e\\nIdeal for fine detail, crafting, and creative work\\u003c/p\\u003e\\n\\n\\u003cp\\u003ePower Series\\u003cbr /\\u003e\\nDesigned for heavy duty use and demanding materials\\u003c/p\\u003e\\n\\n\\u003cp\\u003eEach series is built around how you work, not just how powerful the tool is.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Do I need multiple Dremel tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eMost users can handle a wide range of projects with one Dremel Rotary-Tool and the right accessories. Some advanced users choose multiple tools to specialize, but one Dremel can take you surprisingly far.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"How durable are Dremel Rotary-Tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eDremel tools are built to withstand repeated use across a wide range of projects. They are designed, tested, and refined to deliver long term performance, whether you are working occasionally or putting them to daily use.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Is Dremel the original Rotary-Tool?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eYes. Dremel pioneered the category and remains the leader.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Will I outgrow this tool?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eUnlikely. Your Dremel grows with your skills.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"How do I choose the right Dremel Rotary-Tool for my projects?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eThe best Dremel Rotary-Tool is the one that matches what you actually want to make or fix. That is why Dremel offers three different series that are not step-up levels. They are purpose-built portfolios designed around different types of projects, materials, and working styles.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eRather than asking “Which one is more advanced?” ask:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eWhat materials will I work with most?\\u003c/p\\u003e\\n\\n\\u003cp\\u003eHow detailed or demanding are my projects?\\u003c/p\\u003e\\n\\n\\u003cp\\u003eAm I focused on everyday DIY, creative detail work, or heavy-duty tasks?\\u003cbr /\\u003e\\nFrom there:\\u003cbr /\\u003e\\nSignature Series \\u003d everyday versatility\\u003cbr /\\u003e\\nPrecision Series \\u003d fine detail and controlled craftsmanship\\u003cbr /\\u003e\\nPower Series \\u003d professional-grade strength for tough jobs\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Are the Dremel Signature, Precision, and Power Series different quality levels?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eNo. All Dremel tools are built to the same standards of quality, durability, and reliability. These are not “good, better, best” tiers. They are purpose-built tool families designed around how you work and what you work on.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eThink of them as three different toolkits, each optimized for specific projects and materials.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is the Dremel Signature Series?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eThe Signature Series is Dremel’s flagship collection of do-it-all Rotary-Tools. Designed for versatility, these tools help you tackle a wide range of everyday DIY tasks with confidence.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eThey are built to:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eEngrave\\u003cbr /\\u003e\\nPolish\\u003cbr /\\u003e\\nSand\\u003cbr /\\u003e\\nGrind\\u003cbr /\\u003e\\nSharpen\\u003cbr /\\u003e\\nEtch\\u003cbr /\\u003e\\nCut\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"What projects are the best for the Signature Series?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eThe Signature Series is handiest for:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eEveryday household fixes and maintenance\\u003cbr /\\u003e\\nSanding and detailing furniture\\u003cbr /\\u003e\\nPolishing small to medium items\\u003cbr /\\u003e\\nLight shaping, trimming, and surface prep\\u003cbr /\\u003e\\nGeneral crafting and customization\\u003c/p\\u003e\\n\\n\\u003cp\\u003eIf your DIY list includes a little bit of everything, this series keeps your bold ideas within reach.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Who should choose the Signature Series?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eChoose the Signature Series if you:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eWant one versatile tool for many types of projects\\u003cbr /\\u003e\\nTackle a mix of home improvement, repairs, and light crafting\\u003cbr /\\u003e\\nAre new to Rotary-Tools and want something intuitive and flexible\\u003cbr /\\u003e\\nValue convenience without sacrificing capability\\u003c/p\\u003e\\n\\n\\u003cp\\u003eThis is the go-to option for everyday makers who want dependable performance across a wide range of applications.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Which tools are included in the Dremel Power Series?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eThe Power Series is built for professional-grade performance, durability, and demanding materials. These tools deliver the strength needed for tough jobs while maintaining the versatility Dremel is known for.\\u003c/p\\u003e\\n\\n\\u003cp\\u003ePower Series tools include:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eDremel 8250\\u003c/p\\u003e\\n\\n\\u003cp\\u003eDremel 8240 \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp;\\u003c/p\\u003e\\n\\n\\u003cp\\u003eDremel 4000\\u0026nbsp;\\u003cbr /\\u003e\\nDremel 4300\\u0026nbsp;\\u003c/p\\u003e\\n\\n\\u003cp\\u003eThese tools are ideal for heavy-duty applications such as grinding and sharpening metal, cutting and drilling PVC pipe, routing, and grout removal. If your work involves long-run use, hard materials, or jobsite-level demands, the Power Series is designed to power through.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"Can all Dremel series use the same accessories?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eYes. Dremel accessories are designed to work across compatible Rotary-Tools, allowing you to engrave, cut, polish, sand, grind, and more regardless of which series you choose. This means your tool can grow with your projects over time.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"I want one tool for home repairs and furniture touch-ups. Which series should I choose?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eChoose the Signature Series. It is designed for everyday household fixes, sanding and detailing furniture, polishing, and general DIY.\\u003c/p\\u003e\"}},{\"@type\":\"Question\",\"name\":\"I am new to Rotarry-Tools. Where should I start?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\\u003eStart with the Signature Series. It offers broad versatility, making it easy to learn, experiment, and take on a wide range of DIY projects with confidence. We recommend the Dremel 8150 Brushless Rotary-Tool.\\u003c/p\\u003e\"}}],\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\"},{\"headline\":\"Rotary\",\"author\":{\"@type\":\"Organization\",\"name\":\"© ROBERT BOSCH TOOL CORPORATION 2021. ALL RIGHTS RESERVED.\"},\"datePublished\":\"2025-10-20\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"© ROBERT BOSCH TOOL CORPORATION 2021. ALL RIGHTS RESERVED.\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.dremel.com/images/dremel_w340-png--16fe15ef3de449c0a6662896569f4483.png?imgWidth\\u003d340\\u0026scale\\u003d1\"}},\"dateModified\":\"2026-04-15\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.dremel.com/us/en/resourceapi\"},\"@context\":\"https://schema.org\",\"@type\":\"Article\"}]"}},"ubc699fd994e24e908d3986febcd409eb":{"meta":{},"name":"tracking","type":"component","models":{"trackingModel":{"environment":"prod","profile":"us-pt-rt-oneux-web","universalDataObject":"{\"country\":\"us\",\"language\":\"en\",\"page_breadcrumb\":[\"home\",\"rotary\"],\"page_name\":\"Dremel\\u0027s best selling rotary tools! | Dremel\",\"page_type\":\"other\",\"promotion_name\":[],\"promotion_id\":[]}","trackingForSPA":false,"locale":"en_US"},"showOnlyBody":false}},"u9845934cdbd7415ba20f4d9314025999":{"meta":{},"name":"footer","type":"component","children":[{"$ref":"/page/u2ac5e0c6bf9d418fa0406dc171b7a8a7"},{"$ref":"/page/ue73a87965d964a31a4d2d5d31cee88f1"},{"$ref":"/page/u17697820a0d34b35a8b1c2f224bb3a9f"},{"$ref":"/page/u6d00e4a9dd75498a8802dd775928c4e4"}],"models":{"buttonbBackToTopTittle":"Back To Top","footerNavigationItem":{"navItemsCol1":[{"href":"https://www.dremel.com/us/en/resourceapi/product-categories","target":"SELF","label":"Tools","labelColor":null,"labelFontStyle":null,"header":null,"title":"","linkSuffix":null,"campaignTracking":null,"linkType":null,"icon":null,"disableIconAnimation":null,"iconOnLeft":null,"iconLarge":null,"iconExtraLarge":null,"iconExtraExtraLarge":null,"trackingEvent":null,"socialIconAsHtml":null,"dataQa":"Menu Entry \u0026  Catalog_dremel 2020 39475","phoneNumberLink":false,"emailLink":false},{"href":"https://www.dremel.com/us/en/service-and-support/where-to-buy","target":"SELF","label":"Where to Buy","labelColor":null,"labelFontStyle":null,"header":null,"title":"","linkSuffix":null,"campaignTracking":null,"linkType":null,"icon":null,"disableIconAnimation":null,"iconOnLeft":null,"iconLarge":null,"iconExtraLarge":null,"iconExtraExtraLarge":null,"trackingEvent":null,"socialIconAsHtml":null,"dataQa":"Where To Buy","phoneNumberLink":false,"emailLink":false},{"href":"https://www.dremel.com/us/en/pet-care","target":"SELF","label":"Pet Grooming","labelColor":null,"labelFontStyle":null,"header":null,"title":"","linkSuffix":null,"campaignTracking":null,"linkType":null,"icon":null,"disableIconAnimation":null,"iconOnLeft":null,"iconLarge":null,"iconExtraLarge":null,"iconExtraExtraLarge":null,"trackingEvent":null,"socialIconAsHtml":null,"dataQa":"Pet Shop","phoneNumberLink":false,"emailLink":false},{"href":"https://www.dremel.com/us/en/pumpkin-carving-guide","target":"SELF","label":"Pumpkin Carving","labelColor":null,"labelFontStyle":null,"header":null,"title":"","linkSuffix":null,"campaignTracking":null,"linkType":null,"icon":null,"disableIconAnimation":null,"iconOnLeft":null,"iconLarge":null,"iconExtraLarge":null,"iconExtraExtraLarge":null,"trackingEvent":null,"socialIconAsHtml":null,"dataQa":"Pumpkin Shop","phoneNumberLink":false,"emailLink":false},{"href":"https://ptoeuxdevfilestore.blob.core.windows.net/dremel/United%20States/32123%20Dremel-Catalog-LN-061523.pdf","target":"BLANK","label":"Online Catalog","labelColor":null,"labelFontStyle":null,"header":null,"title":"","linkSuffix":null,"campaignTracking":null,"linkType":null,"icon":null,"disableIconAnimation":null,"iconOnLeft":null,"iconLarge":null,"iconExtraLarge":null,"iconExtraExtraLarge":nu