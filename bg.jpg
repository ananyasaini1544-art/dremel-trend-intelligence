}</style><style data-optly-e8b2955a-d01d-4b65-a240-9aa8c8d36c0a="">.banner {
  background: #EAEBEB;
  transition: background-color 0.3s ease-in-out;
}

.banner:hover {
  background-color: #D8D9DA;
  text-decoration: underline;
}

.banner-text a:link {
  color: #000;
  background-color: transparent;
  text-decoration: none;
}
.banner-text a:visited {
  color: #000;
  background-color: transparent;
  text-decoration: none;
}
.banner-text a:hover {
  color: #000;
  background-color: transparent;
  text-decoration: underline;
}
.banner-text a:active {
  color: #000;
  background-color: transparent;
  text-decoration: underline;
}

.banner-text, .banner-close > span {
  color: #000;
}

        
.banner-text {
  text-align: center;
  flex-grow: 1;
  line-height: 1.4;
  font-family: 'Quicksand', sans-serif;
  font-size: 18px;
}
        
.banner-content {
  padding: 10px;
  margin: 0 auto;
  display: flex;
  align-items: center;
}

/* Mobile Phone */
@media only screen and (max-width: 1100px) {
    .banner, .banner-secondary {
        width: 100%;
    }
    
    .banner-content, .banner-content-secondary {
        width: 90%;
      margin: auto;
    }
  
    .banner-text, .banner-text-secondary {
        font-size: 16px;
        padding: 5px;
    } 
}

.banner-secondary {
  background: #EAEBEB;
  width: 100%;
}

.banner-text-secondary {
  color: #000;
  text-align: center;
  flex-grow: 1;
  line-height: 1.4;
  font-family: 'Quicksand', sans-serif;
  font-size: 18px;
  align-items: center;
}

.banner-content-secondary {
  padding: 10px;
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
}

.header_button {
