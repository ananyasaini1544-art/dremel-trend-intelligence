notes":"","name":""},"engagement":{"notes":"","name":""},"monitoring":{"notes":"","name":""},"crm":{"notes":"","name":""},"display_ads":{"notes":"Nous utilisons ces cookies et autres technologies pour comprendre vos intérêts et diffuser des publicités pour Bosch. Nous essayons également de rendre la publicité plus pertinente et de comprendre les performances des annonces.","name":"Publicité"},"big_data":{"notes":"","name":""},"mobile":{"name":"","notes":""}},"common_tokens":{"yes":"oui","description":"Description","confirmation_button":"Soumettre","status":"Statut","title":"","message":"Nous prenons votre vie privée au sérieux. Vous pouvez modifier les paramètres ci-dessous pour vous assurer que vous êtes à l’aise avec les façons dont nous collectons et utilisons les informations lorsque vous êtes sur <a href=\"https://www.dremel.com/ca/fr\">dremel.com</a>. Nous respectons votre vie privée ; nous ne vendrons jamais vos données personnelles et nous voulons être aussi transparents que possible avec vous concernant vos données. Veuillez consulter notre <a href=”{{privacy_policy_url}}“>avis de confidentialité.</a>","no":"non","category":"Catégorie"},"custom_tokens":{"privacy_policy_text":"","dremel_site":"","company_logo_url":"","privacy_policy_url":"https://www.dremel.com/ca/fr/service-et-support/politique-de-confidentialité"},"isDefault":"false"},"en":{"isDefault":"true","custom_tokens":{"privacy_policy_url":"https://www.dremel.com/us/en/service-and-support/privacy-notice","dremel_site":"https://www.dremel.com/us/en","company_logo_url":"","privacy_policy_text":""},"common_tokens":{"description":"Description","yes":"yes","status":"Status","title":"","confirmation_button":"Submit","category":"Category","no":"no","message":"We take your privacy seriously. You can change the settings below to make sure you’re comfortable with the ways we collect and use information while you’re on <a href=\"{{dremel_site}}\">dremel.com</a>. We respect your privacy; we will never sell your personal data, and we want to be as transparent as we can with you regarding your data. Please see our <a href=\"{{privacy_policy_url}}\">privacy notice.</a>"},"categories":{"misc":{"notes":"We use these cookies and other technologies to provide essential services and functionality, such as site security, site integrity, load balancing and session ID. <a href=\"https://www.dremel.com/us/en/service-and-support/privacy-notice\">Click here to learn more</a> about cookies and other technologies we use.","name":"Essential"},"cdp":{"name":"","notes":""},"affiliates":{"notes":"","name":""},"personalization":{"name":"","notes":""},"search":{"notes":"","name":""},"analytics":{"notes":"When you access our websites and apps from a computer or other device, we use these cookies and other technologies to improve our products and services, as well as your experience on our website.","name":"Analytics"},"uncategorized":{"notes":"","name":""},"email":{"name":"","notes":""},"engagement":{"name":"","notes":""},"monitoring":{"name":"","notes":""},"social":{"name":"Social Media","notes":"If you share our content on Facebook, Twitter, or other social media accounts, thank you. We may track what Bosch Tools content you share, to help us hone our social media content to a razor sharp edge. Selecting No will block this tracking."},"cookiematch":{"notes":"","name":""},"big_data":{"notes":"","name":""},"crm":{"name":"","notes":""},"display_ads":{"notes":"We use these cookies and other technologies to understand your interests and deliver advertising for Bosch. We also try to make advertising more relevant and to understand ad performance. ","name":"Advertising"},"mobile":{"notes":"","name":""}}}};utag.gdpr.preferences_prompt.content.css="";utag.gdpr.preferences_prompt.content.html="";utag.gdpr.preferences_prompt.content.js="(function preferences_prompt(){var $el=document.getElementById(\"preferences_prompt_submit\"),$modal=document.getElementById(\"__tealiumGDPRcpPrefs\"),$closeBtn=$modal.g