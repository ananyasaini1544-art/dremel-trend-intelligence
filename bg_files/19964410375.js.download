// Copy/Paste products Above to other Variation to Update Prices/Promos/Coupons

// MERCHANDISING PLACEMENT
const currentUrl = window.location.href.split(/[?#]/)[0];
const productModel = currentUrl.split('/').pop();

const productData = products.find(product => product.model === productModel);

if (productData) {
    const headlineWrapper = document.querySelector('[class^="Stage_headlineWrapper__"]');
    const headlineWrapperMobile = document.querySelector('[class^="Stage_headlineWrapperMobile__"]');
    const categoryDivs = headlineWrapper.querySelectorAll('[class^="Categories_categories__"]');
    const categoryDivsMobile = headlineWrapperMobile.querySelectorAll('[class^="Categories_categories__"]');
    const conversionArea = document.querySelector('[class^="ConversionArea_container__"]');
    const priceDisplay = document.querySelector('[class^="ProductDisplayPrice_price"]');
    const conversionBarPrice = document.querySelector('[class^="ConversionBar_mobWrapper___MTQt"] [class^="ConversionBar_price__"]');
  	const conversionButtons = document.querySelector('[class^="ConversionArea_buttons___"]');
  	const galleryWrapper = document.querySelector('[class^="Stage_galleryWrapper__"]');

    const merchMessage = productData.merchandising;
    const promoPrice = productData.promoPrice;
    const slashedPrice = productData.slashedPrice;
    const couponMessage = productData.coupon;
    const couponCode = productData.code;

    const promoBadgingElement = `<div class="promo-badging">${merchMessage}</div>`;
    const promoPricingElementNav = `<span class="promo-price-nav">$${promoPrice}</span><span class="regular-price-nav">List Price: <s>$${slashedPrice}</s></span>`;
    const promoPricingElement = `<div class="promo-price">$${promoPrice}</div><span class="regular-price">List Price: <s>$${slashedPrice}</s></span>`;
    const couponBadgingElement = `<div class="coupon-button-area"><button id="couponButton" class="coupon-button" title="Click to Copy" aria-label="Copy coupon code to clipboard"><span id="iconContainer" class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/></svg></span><span id="couponText">Code: ${couponCode}</span></button></div>`;

    const promoTagHtml = '<div class="Categories_categories__372Cg"><p class="Categories_category__obGDp" style="background-color:#C00000;color:#FFFFFF">Promo</p></div>';
    const couponTagHtml = '<div class="Categories_categories__372Cg"><p class="Categories_category__obGDp" style="background-color:green;color:#FFFFFF">Coupon</p></div>';
  
  
      const ribbonPromoHtml = `<div class="cip-giftwrap-label cip-giftwrap-label--ribbon" data-cip-giftwrap-bound="true"><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--left"></span><div class="cip-promo-ribbon-bar">${merchMessage}</div><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--right"></span></div>`;
      const ribbonCouponHtml = `<div class="cip-giftwrap-label cip-giftwrap-label--ribbon" data-cip-giftwrap-bound="true"><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--left"></span><div class="cip-coupon-ribbon-bar">${couponMessage}</div><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--right"></span></div>`;


    // Check for merchandising message
    if (merchMessage) {
        if (conversionArea) {
            conversionArea.insertAdjacentHTML('beforebegin', promoBadgingElement);
        }
        if (headlineWrapper) {
            categoryDivs.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
        if (headlineWrapperMobile) {
            categoryDivsMobile.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
        }

        if (promoPrice) {
            if (priceDisplay) {
                priceDisplay.innerHTML = '';
                priceDisplay.insertAdjacentHTML('beforeend', promoPricingElement);
            }
            if (conversionBarPrice) {
                conversionBarPrice.innerHTML = promoPricingElementNav;
