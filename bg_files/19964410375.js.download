: 0;\r\n  transform: translate(24%, 80%) rotate(45deg);\r\n  z-index: 5;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* Ribbon triangles */\r\n.cip-giftwrap-ribbon-triangle {\r\n  display:none!important;\r\n  width: 0;\r\n  height: 0;\r\n  border-bottom: 11px solid rgb(133, 0, 0);\r\n  border-left: 11px solid transparent;\r\n  border-right: 11px solid transparent;\r\n  z-index: -1;\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--left {\r\n  transform: rotate(-45deg) translate(-62%, 140%);\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--right {\r\n  transform: rotate(45deg) translate(30%, 200%);\r\n}\r\n\r\n/* Ribbon bar */\r\n.cip-promo-ribbon-bar {\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-coupon-ribbon-bar {\r\n  background-color: green;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-promo-ribbon-bar img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Icon (round, unfolding text)\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--icon {\r\n  position: absolute;\r\n  top: 16px;\r\n  left: 16px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  border-radius: 9999px;\r\n  padding: 8px;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  z-index: 5;\r\n  transition: padding-right 0.2s ease;\r\n}\r\n\r\n.cip-giftwrap-label--icon img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n@media (max-width:991px) {\r\n  .cip-giftwrap-label--icon {\r\n  \ttop:0;\r\n    left:0;\r\n  }\r\n}\r\n@media (min-width:992px) {\r\n  /* Text span: hidden by default */\r\n  .cip-giftwrap-label__text {\r\n    white-space: nowrap;\r\n    margin-left: 0;\r\n    opacity: 0;\r\n    max-width: 0;\r\n    overflow: hidden;\r\n    transition: opacity 0.2s ease, max-width 0.2s ease, margin-left 0.2s ease;\r\n  }\r\n\r\n  /* When expanded (hover) */\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded {\r\n    padding-right: 16px;\r\n  }\r\n\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded .cip-giftwrap-label__text {\r\n    margin-left: 8px;\r\n    opacity: 1;\r\n    max-width: 200px;\r\n  }\r\n}</style>"}]}]}, {"id": "4763806912479232", "name": "Banner Only", "actions": [{"viewId": "5596485002199040", "changes": [{"id": "998B7308-9318-4FD6-B4F3-9F5A68113570", "type": "custom_code", "dependencies": [], "name": "", "isOpalManaged": false, "value": function($){// PRODUCT INPUT MAPPING, Copy/Paste products Below to other Variation to Update Prices/Promos/Coupons
