        mm12v: `<div class="jumbotron static-hero"><div class="static-hero__background-image"><picture><source media="(min-width: 1200px)" srcset="https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=1920&amp;imgHeight=768&amp;scale=1 1x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=3840&amp;imgHeight=1536&amp;scale=1 2x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=5760&amp;imgHeight=2304&amp;scale=1 3x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=7680&amp;imgHeight=3072&amp;scale=1 4x"><source media="(min-width: 992px)" srcset="https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=1200&amp;imgHeight=480&amp;scale=1 1x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=2400&amp;imgHeight=960&amp;scale=1 2x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=3600&amp;imgHeight=1440&amp;scale=1 3x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=4800&amp;imgHeight=1920&amp;scale=1 4x"><source media="(min-width: 768px)" srcset="https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=991&amp;imgHeight=557&amp;scale=1 1x, https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=1982&imgHeight=1114&scale=1 2x, https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=2973&imgHeight=1671&scale=1 3x, https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=3964&imgHeight=2228&scale=1 4x"><source media="(min-width: 416px)" srcset="https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=767&imgHeight=431&scale=1 1x, https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=1534&imgHeight=862&scale=1 2x, https://www.dremel.com/images/jumbotron_multi-tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=2301&imgHeight=1293&scale=1 3x, https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=3068&imgHeight=1724&scale=1 4x"><source srcset="https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=415&imgHeight=234&scale=1 1x, https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=830&imgHeight=468&scale=1 2x, https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=1245&imgHeight=702&scale=1 3x, https://www.dremel.com/images/jumbotron_multi_tool--db23507d3e3a47cb9205701761e8fb06.jpg?imgWidth=1660&imgHeight=936&scale=1 4x"><img alt="The ultimate problem-solver for every DIY project - Dremel Blueprint MM12V Multi-Tool" decoding="async" loading="lazy" srcset="https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=1920&imgHeight=768&scale=1 1x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=3840&imgHeight=1536&scale=1 2x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=5760&imgHeight=2304&scale=1 3x, https://www.dremel.com/images/jumbotron_multi-tool--7a649318ae4b4b14b1087f1ee29ec881.jpg?imgWidth=7680&imgHeight=3072&scale=1 4x"></picture></div><div class="static-hero__content-wrapper"><div class="static-hero__text-box"><h2 class="static-hero__title">The ultimate problem-solver for every DIY project</h2><p class="static-hero__description">Get multiple tasks done with one tool, making the Multi-Tool a must have for any DIY project!</p></div></div></div>`
    };

    const originalJumbotron = document.querySelector('.CatalogProduct_belowstageContainer__Xjcf8 .jumbotron');
    
    if (originalJumbotron) {
        originalJumbotron.insertAdjacentHTML('beforebegin', bundleSection);
        
        const bundleTileContainer = document.querySelector('.bundle-section');
        if (bundleTileContainer) {
            if (productData.bpaa === 'true') {
                bundleTileContainer.insertAdjacentHTML('beforeend', createBpaaTile(bpaaBundleData));
            }
            if (productData.bpab === 'true') {
                bundleTileContainer.insertAdjacentHTML('beforeend', createBpabTile(bpabBundleData));
            }
        }
        let newJumbotronHtml = null;
        if (productData.model.includes('cs12v')) newJumbotronHtml = jumbotrons.cs12v;
        else if (productData.model.includes('dd12v')) newJumbotronHtml = jumbotrons.dd12v;
        else if (productData.model.includes('mm12v')) newJumbotronHtml = jumbotrons.mm12v;

        if (newJumbotronHtml) {
            originalJumbotron.outerHTML = newJumbotronHtml;
        }
    }
}

function applyMerchandising(merchMessage, promoPrice, slashedPrice) {
    const headlineWrapper = document.querySelector('[class^="Stage_headlineWrapper_"]');
    const headlineWrapperMobile = document.querySelector('[class^="Stage_headlineWrapperMobile_"]');
    const conversionArea = document.querySelector('[class^="ConversionArea_container_"]');
    const priceDisplay = document.querySelector('[class^="ProductDisplayPrice_price"]');
    const conversionBarPrice = document.querySelector('[class^="ConversionBar_mobWrapper"] [class^="ConversionBar_price_"]');
    const galleryWrapper = document.querySelector('[class^="Stage_galleryWrapper_"]');
    const promoPricingElementNav = `<span class="promo-price-nav">$${promoPrice}</span><span class="regular-price-nav">Total Value: <s>$${slashedPrice}</s></span>`;
    const promoPricingElement = `<div class="promo-price">$${promoPrice}</div><span class="regular-price">Total Value: <s>$${slashedPrice}</s></span>`;
    const promoTagHtml = '<div class="Categories_categories__372Cg"><p class="Categories_category__obGDp" style="background-color:#C00000;color:#FFFFFF">Combo Kit</p></div>';
    const ribbonPromoHtml = `<div class="cip-giftwrap-label cip-giftwrap-label--ribbon" data-cip-giftwrap-bound="true"><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--left"></span><div class="cip-promo-ribbon-bar">${merchMessage}</div><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--right"></span></div>`;
    if (merchMessage) {
        if (headlineWrapper) {
            headlineWrapper.querySelectorAll('[class^="Categories_categories_"]').forEach(categoryDiv => categoryDiv.insertAdjacentHTML('afterend', promoTagHtml));
        }
        if (headlineWrapperMobile) {
            headlineWrapperMobile.querySelectorAll('[class^="Categories_categories_"]').forEach(categoryDiv => categoryDiv.insertAdjacentHTML('afterend', promoTagHtml));
        }
        if (galleryWrapper) {
            galleryWrapper.insertAdjacentHTML('beforeend', ribbonPromoHtml);
            galleryWrapper.classList.add('cip-giftwrap-gallery');
        }
    }
    if (promoPrice) {
        if (priceDisplay) {
            priceDisplay.innerHTML = '';
            priceDisplay.insertAdjacentHTML('beforeend', promoPricingElement);
        }
        if (conversionBarPrice) {
            conversionBarPrice.innerHTML = promoPricingElementNav;
        }
    }
}

function main() {
    const currentUrl = window.location.href.split(/[?#]/)[0];
    const productModel = currentUrl.split('/').pop();

    const blueprintProductData = blueprintProducts.find(product => product.model === productModel);
    if (blueprintProductData) {
        handleBlueprintProductLogic(blueprintProductData);
        return; 
    }

    const bundleProductData = bundleProducts.find(product => product.model === productModel);
    if (bundleProductData) {
        applyMerchandising(
            bundleProductData.merchandising, 
            bundleProductData.promoPrice, 
            bundleProductData.slashedPrice
        );
        return; 
    }
}

const observer = setInterval(() => {
    const bundleElementReady = document.querySelector('[class^="Stage_headlineWrapper_"]');
    const blueprintElementReady = document.querySelector('.CatalogProduct_belowstageContainer__Xjcf8 .jumbotron');

    if (bundleElementReady || blueprintElementReady) {
        clearInterval(observer);
        main();
    }
}, 100);
