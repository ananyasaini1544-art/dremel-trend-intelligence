	      { model: '737-01-26150737dc', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
];
// Copy/Paste products Above to other Variation to Update Prices/Promos/Coupons

// MERCHANDISING PLACEMENT
const currentUrl = window.location.href.split(/[?#]/)[0];
const productModel = currentUrl.split('/').pop();

const productData = products.find(product => product.model === productModel);

if (productData) {
    const headlineWrapper = document.querySelector('[class^="Stage_headlineWrapper__"]');
    const headlineWrapperMobile = document.querySelector('[class^="Stage_headlineWrapperMobile__"]');
    const categoryDivs = headlineWrapper.querySelectorAll('[class^="Categories_categories__"]');
    const categoryDivsMobile = headlineWrapperMobile.querySelectorAll('[class^="Categories_categories__"]');
    const conversionArea = document.querySelector('[class^="ConversionArea_container__"]');
    const priceDisplay = document.querySelector('[class^="ProductDisplayPrice_price"]');
    const conversionBarPrice = document.querySelector('[class^="ConversionBar_mobWrapper___MTQt"] [class^="ConversionBar_price__"]');
  	const conversionButtons = document.querySelector('[class^="ConversionArea_buttons___"]');
  	const galleryWrapper = document.querySelector('[class^="Stage_galleryWrapper__"]');

    const merchMessage = productData.merchandising;
    const promoPrice = productData.promoPrice;
    const slashedPrice = productData.slashedPrice;
    const couponMessage = productData.coupon;
    const couponCode = productData.code;

    const promoBadgingElement = `<div class="promo-badging">${merchMessage}</div>`;
    const promoPricingElementNav = `<span class="promo-price-nav">$${promoPrice}</span><span class="regular-price-nav">List Price: <s>$${slashedPrice}</s></span>`;
    const promoPricingElement = `<div class="promo-price">$${promoPrice}</div><span class="regular-price">List Price: <s>$${slashedPrice}</s></span>`;
    const couponBadgingElement = `<div class="coupon-button-area"><button id="couponButton" class="coupon-button" title="Click to Copy" aria-label="Copy coupon code to clipboard"><span id="iconContainer" class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/></svg></span><span id="couponText">Code: ${couponCode}</span></button></div>`;

    const promoTagHtml = '<div class="Categories_categories__372Cg"><p class="Categories_category__obGDp" style="background-color:#C00000;color:#FFFFFF">Promo</p></div>';
    const couponTagHtml = '<div class="Categories_categories__372Cg"><p class="Categories_category__obGDp" style="background-color:green;color:#FFFFFF">Coupon</p></div>';
  
  
      const ribbonPromoHtml = `<div class="cip-giftwrap-label cip-giftwrap-label--ribbon" data-cip-giftwrap-bound="true"><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--left"></span><div class="cip-promo-ribbon-bar">${merchMessage}</div><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--right"></span></div>`;
      const ribbonCouponHtml = `<div class="cip-giftwrap-label cip-giftwrap-label--ribbon" data-cip-giftwrap-bound="true"><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--left"></span><div class="cip-coupon-ribbon-bar">${couponMessage}</div><span class="cip-giftwrap-ribbon-triangle cip-giftwrap-ribbon-triangle--right"></span></div>`;


    // Check for merchandising message
    if (merchMessage) {
        if (conversionArea) {
            conversionArea.insertAdjacentHTML('beforebegin', promoBadgingElement);
        }
        if (headlineWrapper) {
            categoryDivs.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
        if (headlineWrapperMobile) {
            categoryDivsMobile.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
				if (galleryWrapper) {
                galleryWrapper.insertAdjacentHTML('beforeend', ribbonPromoHtml);
          			galleryWrapper.classList.add('cip-giftwrap-gallery');
        }
        }

        if (promoPrice) {
            if (priceDisplay) {
                priceDisplay.innerHTML = '';
                priceDisplay.insertAdjacentHTML('beforeend', promoPricingElement);
            }
            if (conversionBarPrice) {
                conversionBarPrice.innerHTML = promoPricingElementNav;
            }
        }

else if (couponMessage) { // Check for coupon message if no merch message
        if (conversionArea) {
            conversionArea.insertAdjacentHTML('beforebegin', couponBadgingElement);
        }
        if (headlineWrapper) {
            categoryDivs.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', couponTagHtml);
            });
        }
        if (headlineWrapperMobile) {
            categoryDivsMobile.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', couponTagHtml);
            });
        }
        if (galleryWrapper) {
          galleryWrapper.insertAdjacentHTML('beforeend', ribbonCouponHtml);
          galleryWrapper.classList.add('cip-giftwrap-gallery');
        }
    }

    // Add event listener for the coupon button
    document.getElementById('couponButton').addEventListener('click', function() {
        const iconContainer = document.getElementById('iconContainer');
        const couponText = document.getElementById('couponText');

        navigator.clipboard.writeText(couponCode).then(() => {
            iconContainer.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-check" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                </svg>
            `;
            couponText.textContent = `Code: Copied!`; // Update text to indicate copied status

            // Change the title for hover text
            this.title = 'Copied!';

            setTimeout(() => {
                iconContainer.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
                        <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                        <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                    </svg>
                `;
                couponText.textContent = `Code: ${couponCode}`; // Reset text to original
                this.title = 'Click to Copy';
            }, 2000);
        });
    });
  }
}}, {"id": "F12C1138-F33A-4489-B656-C6915DA7E490", "type": "append", "dependencies": [], "name": "", "isOpalManaged": false, "selector": "head", "value": "<style>.coupon-button {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 15px 20px;\r\n    font-size: 16px;\r\n  \tfont-weight: bold;\r\n    border: none;\r\n    border-radius: 5px;\r\n    background-color: green;\r\n    color: white;\r\n    cursor: pointer;\r\n    transition: background-color 0.3s;\r\n  \tmargin: auto;\r\n}\r\n\r\n.coupon-button:hover {\r\n    background-color: #004D00;\r\n}\r\n\r\n.icon {\r\n    margin-right: 8px;\r\n    transition: opacity 0.3s;\r\n}\r\n\r\n\r\n.regular-price {\r\nfont-size: 0.85em;\r\nfont-weight: normal;\r\ncolor: #757575;\r\nmargin-left: 10px;\r\n}\r\n\r\n.regular-price-nav {\r\nfont-size: 0.45em;\r\nfont-weight: normal;\r\ncolor: #C4C4C4;\r\nmargin-left: 10px;\r\n}\r\n\r\n.promo-price {\r\nfont-size: 32px;\r\nfont-weight: 700;\r\n}\r\n\r\n.regular-price-nav {\r\nfont-size: 12px;\r\nfont-weight: normal;\r\n}\r\n\r\n\r\n@media (min-width: 992px) {\r\n    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 19px;\r\n\t}\r\n}\r\n\t\r\n@media (min-width: 768px) and (max-width: 991px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 9px;\r\n\t}\r\n}\r\n\r\n@media (max-width: 767px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 8px;\r\n\t}\r\n}\r\n\r\n\r\n.ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV :nth-child(2) {\r\n  display: block;\r\n}\r\n\r\n@media (max-width: 450px) {\r\n    .ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV {\r\n  display: initial;\r\n    }\r\n}\r\n\r\n\r\n.coupon-badging {\t\r\n  background-color: green;\r\n  color: #FFFFFF;\r\n  font-size: 16px; \r\n  font-weight: bold;\r\n  padding: 10px;\r\n  text-align: center;\r\n  width: fit-content;\r\n  height: fit-content;\r\n  margin: auto;\r\n}\r\n\r\n.promo-badging {\t\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  font-size: 16px; \r\n  font-weight: bold;\r\n  padding: 10px;\r\n  text-align: center;\r\n  width: fit-content;\r\n  height: fit-content;\r\n  margin: auto;\r\n}\r\n\r\n.ProductDisplayPrice_priceAndVat__GpiGU {\r\n  display: flex;\r\n  flex-direction: column;\r\n  text-align: right;\r\n}\r\n\r\n\r\n/* Shared layout helpers */\r\n.cip-giftwrap-stage-headline,\r\n.cip-giftwrap-categories {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media(max-width: 991px) {\r\n  .cip-giftwrap-stage-headline[class*=Mobile],\r\n  .cip-giftwrap-stage-headline[class*=Mobile] .cip-giftwrap-categories {\r\n  \tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n@media(min-width: 992px) {\r\n  .cip-giftwrap-stage-headline:not([class*=Mobile]),\r\n  .cip-giftwrap-stage-headline:not([class*=Mobile]) .cip-giftwrap-categories {\r\n  \tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n.cip-giftwrap-gallery {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding-top:10px;\r\n}\r\n\r\n/* Base label class (minimal defaults) */\r\n.cip-giftwrap-label {\r\n  background: #C00000!important;\r\n  color: #FFFFFF;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Category pill\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  padding-right: 0.8em;\r\n  padding-left: 0.2em;\r\n  border-radius: 99em;\r\n}\r\n\r\n.cip-giftwrap-label--pill img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Image ribbon\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--ribbon {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  transform: translate(24%, 80%) rotate(45deg);\r\n  z-index: 5;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* Ribbon triangles */\r\n.cip-giftwrap-ribbon-triangle {\r\n  display:none!important;\r\n  width: 0;\r\n  height: 0;\r\n  border-bottom: 11px solid rgb(133, 0, 0);\r\n  border-left: 11px solid transparent;\r\n  border-right: 11px solid transparent;\r\n  z-index: -1;\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--left {\r\n  transform: rotate(-45deg) translate(-62%, 140%);\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--right {\r\n  transform: rotate(45deg) translate(30%, 200%);\r\n}\r\n\r\n/* Ribbon bar */\r\n.cip-promo-ribbon-bar {\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-coupon-ribbon-bar {\r\n  background-color: green;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-promo-ribbon-bar img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Icon (round, unfolding text)\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--icon {\r\n  position: absolute;\r\n  top: 16px;\r\n  left: 16px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  border-radius: 9999px;\r\n  padding: 8px;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  z-index: 5;\r\n  transition: padding-right 0.2s ease;\r\n}\r\n\r\n.cip-giftwrap-label--icon img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n@media (max-width:991px) {\r\n  .cip-giftwrap-label--icon {\r\n  \ttop:0;\r\n    left:0;\r\n  }\r\n}\r\n@media (min-width:992px) {\r\n  /* Text span: hidden by default */\r\n  .cip-giftwrap-label__text {\r\n    white-space: nowrap;\r\n    margin-left: 0;\r\n    opacity: 0;\r\n    max-width: 0;\r\n    overflow: hidden;\r\n    transition: opacity 0.2s ease, max-width 0.2s ease, margin-left 0.2s ease;\r\n  }\r\n\r\n  /* When expanded (hover) */\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded {\r\n    padding-right: 16px;\r\n  }\r\n\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded .cip-giftwrap-label__text {\r\n    margin-left: 8px;\r\n    opacity: 1;\r\n    max-width: 200px;\r\n  }\r\n}</style>"}]}]}], "weightDistributions": [{"entityId": "5696738032353280", "endOfRange": 3333}, {"entityId": "4763806912479232", "endOfRange": 6666}, {"entityId": "5677279750127616", "endOfRange": 10000}], "name": "US D2C Merchandising (PDPs) - v2", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "min-time", "layerId": "5137567650152448"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["5596485002199040"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "5471378380423168", "name": "US D2C Merchandising (Landing Pages) (Borders & Buttons)", "commitId": "4958013136568320", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "26314140820"], "audienceName": "Country = US", "changes": null, "id": "4948254685659136", "integrationSettings": null, "variations": [{"id": "4979880408907776", "name": "Original", "actions": [{"viewId": "4824662786441216", "changes": [{"id": "9e19c6f4aad14a9ea135c0e77099d5eb", "type": "custom_code", "value": function($){// PRODUCT INPUT MAPPING, Copy/Paste products Below to other Variation to Update Prices/Promos/Stock
const products = [
    // Batteries
    { model: 'B815-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'B816-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'B20V20 20V', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Rotary
    { model: '100-1/58', merchandising: 'Save 50%', slashedPrice: '59.99', promoPrice: '29.99', coupon: '', stockOut: ''},
    { model: '100-2/44', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: '2050-15', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '3000-2/25', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: '3100-1/15', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '4000-2/32', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
  	{ model: '4300-5/40', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '4300-9/64', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '7760 N/10', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '8240-5', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '8250-5', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
  
    // Oscillating
    { model: 'MM20V-02', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: 'MM50-02', merchandising: 'Save $30', slashedPrice: '129.99', promoPrice: '99.99', coupon: '', stockOut: ''},
    
    // Home Solutions
    { model: 'PC10-07', merchandising: 'Save $10', slashedPrice: '59.99', promoPrice: '49.99', coupon: '', stockOut: ''},
    { model: 'HSES-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: 'HSFL-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: 'HSGP-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: 'Out of Stock'},
    { model: 'HSSC-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'HSSC-02', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'PC360-5', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'PC501', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Accessory Kits
    { model: '730-02', merchandising: 'Save $5', slashedPrice: '19.99', promoPrice: '14.99', coupon: '', stockOut: ''},
    { model: '736-01', merchandising: 'Save $5', slashedPrice: '19.99', promoPrice: '14.99', coupon: '', stockOut: ''},
    { model: 'EZ727-01', merchandising: 'Save $10', slashedPrice: '29.99', promoPrice: '19.99', coupon: '', stockOut: ''},
    
    // Attachments
    { model: '225-02', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
  
    // Pet Care
    { model: '7350-PETD', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '7760-PGKD', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '738-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'AT02-PGK', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: '',},
    { model: '416HP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'SD60-PGK', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Blueprint
    { model: 'DD12V-S1', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS12V-S1C', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'Multi-Tool', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS500', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS600', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Pumpkin
    { model: '7350-PMP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '2050-PMP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '737-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
];
// Copy/Paste products Above to other Variation to Update Prices/Promos/Stock

// Merchandising Placement
const teaserDivs = document.querySelectorAll('[class^="StandardTeaserRow_teaser"]');
teaserDivs.forEach(div => {
    const messageSpan = div.querySelector('[class^="RichText_container"]');
    const imageAnchor = div.querySelector('[class^="StandardTeaserRow_imageContainer"]');
    const existingPrice = div.querySelector('strong');

    if (messageSpan && imageAnchor && existingPrice) {
        let priceModifiedForTeaser = false;

        products.forEach(product => {
            const modelNumber = product.model;
            if (messageSpan.innerHTML && messageSpan.innerHTML.includes(modelNumber) && !priceModifiedForTeaser) {
                const promoPrice = product.promoPrice;
                const slashedPrice = product.slashedPrice;
                const merchMessage = product.merchandising;
                const couponMessage = product.coupon;
                const stockOutMessage = product.stockOut;

                if (stockOutMessage) {
                    if (!imageAnchor.querySelector('.stock-out-message')) {
                        imageAnchor.insertAdjacentHTML('afterbegin', `<div class="stock-out-message badging-left">${stockOutMessage}</div>`);
                        imageAnchor.id = "Stock-Out";
                    }
                } else {
                    const parentOfPrice = existingPrice.parentElement;
                    const listPriceAlreadyExists = parentOfPrice.querySelector('.list-price');

                    if (promoPrice && slashedPrice && !listPriceAlreadyExists) {
                        if (!imageAnchor.querySelector('.promo-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="promo-badging badging-left">${merchMessage}</div>`);
                            imageAnchor.id = "Promo-Savings";
                        }

                        const priceHTML = `<strong>$${promoPrice}</strong><span class="list-price">List Price: <s>$${slashedPrice}</s></span>`;
                        
                        existingPrice.remove();
                        parentOfPrice.insertAdjacentHTML('beforeend', priceHTML);
                        priceModifiedForTeaser = true;

                    } else if (couponMessage) {
                        if (!imageAnchor.querySelector('.coupon-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="coupon-badging badging-left">${couponMessage}</div>`);
                            imageAnchor.id = "Coupon-Savings";
                        }
                    }
                }
            }
        });
    }
});
