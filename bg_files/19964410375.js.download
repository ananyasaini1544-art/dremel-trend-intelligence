const products = [
	// Bundles
    { model: 'BP12AA', merchandising: 'Combo Kit Value', slashedPrice: '248.00', promoPrice: '199.99'},
    { model: 'BP12AB', merchandising: 'Combo Kit Value', slashedPrice: '387.99', promoPrice: '299.99'},
];
// Copy/Paste products Above to other Variation to Update Prices/Promos


// Merchandising Placement
const teaserDivs = document.querySelectorAll('[class^="StandardTeaserRow_teaser"]');
teaserDivs.forEach(div => {
    const messageSpan = div.querySelector('[class^="RichText_container"]');
    const imageAnchor = div.querySelector('[class^="StandardTeaserRow_imageContainer"]');
    const existingPrice = div.querySelector('strong');

    if (messageSpan && imageAnchor && existingPrice) {
        let priceModifiedForTeaser = false;

        products.forEach(product => {
            const modelNumber = product.model;
            if (messageSpan.innerHTML && messageSpan.innerHTML.includes(modelNumber) && !priceModifiedForTeaser) {
                const promoPrice = product.promoPrice;
                const slashedPrice = product.slashedPrice;
                const merchMessage = product.merchandising;
                const parentOfPrice = existingPrice.parentElement;
                const listPriceAlreadyExists = parentOfPrice.querySelector('.list-price');

                    if (promoPrice && slashedPrice && !listPriceAlreadyExists) {
                        if (!imageAnchor.querySelector('.promo-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="promo-badging badging-left">${merchMessage}</div>`);
                            imageAnchor.id = "Bundle";
                        }

                        const priceHTML = `<strong>$${promoPrice}</strong><span class="list-price">Total Value: <s>$${slashedPrice}</s></span>`;
                        
                        existingPrice.remove();
                        parentOfPrice.insertAdjacentHTML('beforeend', priceHTML);
                        priceModifiedForTeaser = true;

                    }
            }
        });
    }
});
}, "dependencies": []}, {"id": "9cb520403c8c4c13a332a63d7b0fa432", "type": "append", "selector": "head", "value": "<style>.promo-price{\n  font-weight: bold;\n}\n\n.list-price{\n  font-size: .90rem;\n  color: #4D4D4D;\n  margin-left: 1.0rem;\n}\n\n.badging-left {\n  font-size: 16px;\n  font-weight: bold;\n  text-align: center;\n  width: fit-content;\n  padding: 20px;\n  display: inline-flex;\n  align-items: center;\n  position: absolute;\n  line-height: 12px;\n  border-radius: 999em;\n  transform: translateX(-12px) translateY(-30%);\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n.promo-badging {\n  background-color: #C00000;\n  color: #FFFFFF;\n}\n\n@media (max-width: 1020px) and (min-width: 768px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n@media (max-width: 360px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n.promo-badging:hover {\n    background-color: #850000;\n}</style>", "dependencies": []}]}]}, {"id": "6242029831716864", "name": "Variant #1", "actions": [{"viewId": "4824662786441216", "changes": [{"id": "D65B369C-EA72-4F5C-87E4-3E738A655FD4", "type": "custom_code", "value": function($){// PRODUCT INPUT MAPPING, Copy/Paste products Below to other Variation to Update Prices/Promos
const products = [
	// Bundles
    { model: 'BP12AA', merchandising: 'Bundle & Save', slashedPrice: '248.00', promoPrice: '199.99'},
    { model: 'BP12AB', merchandising: 'Bundle & Save', slashedPrice: '387.99', promoPrice: '299.99'},
];
// Copy/Paste products Above to other Variation to Update Prices/Promos


// Merchandising Placement
const teaserDivs = document.querySelectorAll('[class^="StandardTeaserRow_teaser"]');
teaserDivs.forEach(div => {
    const messageSpan = div.querySelector('[class^="RichText_container"]');
    const imageAnchor = div.querySelector('[class^="StandardTeaserRow_imageContainer"]');
    const existingPrice = div.querySelector('strong');

    if (messageSpan && imageAnchor && existingPrice) {
        let priceModifiedForTeaser = false;

        products.forEach(product => {
            const modelNumber = product.model;
            if (messageSpan.innerHTML && messageSpan.innerHTML.includes(modelNumber) && !priceModifiedForTeaser) {
                const promoPrice = product.promoPrice;
                const slashedPrice = product.slashedPrice;
                const merchMessage = product.merchandising;
                const parentOfPrice = existingPrice.parentElement;
                const listPriceAlreadyExists = parentOfPrice.querySelector('.list-price');

                    if (promoPrice && slashedPrice && !listPriceAlreadyExists) {
                        if (!imageAnchor.querySelector('.promo-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="promo-badging badging-left">${merchMessage}</div>`);
                            imageAnchor.id = "Bundle";
                        }

                        const priceHTML = `<strong>$${promoPrice}</strong><span class="list-price">Total Value: <s>$${slashedPrice}</s></span>`;
                        
                        existingPrice.remove();
                        parentOfPrice.insertAdjacentHTML('beforeend', priceHTML);
                        priceModifiedForTeaser = true;

                    }
            }
        });
    }
});
}, "dependencies": []}, {"id": "8CA6F933-FFE7-4E20-AF08-E2920941C48F", "type": "append", "selector": "head", "value": "<style>.promo-price{\n  font-weight: bold;\n}\n\n.list-price{\n  font-size: .90rem;\n  color: #4D4D4D;\n  margin-left: 1.0rem;\n}\n\n.badging-left {\n  font-size: 16px;\n  font-weight: bold;\n  text-align: center;\n  width: fit-content;\n  padding: 20px;\n  display: inline-flex;\n  align-items: center;\n  position: absolute;\n  line-height: 12px;\n  border-radius: 999em;\n  transform: translateX(-12px) translateY(-30%);\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n.promo-badging {\n  background-color: #C00000;\n  color: #FFFFFF;\n}\n\n@media (max-width: 1020px) and (min-width: 768px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n@media (max-width: 360px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n.promo-badging:hover {\n    background-color: #850000;\n}</style>", "dependencies": []}]}]}], "weightDistributions": [{"entityId": "5433815133323264", "endOfRange": 5000}, {"entityId": "6242029831716864", "endOfRange": 10000}], "name": "US D2C Merchandising (Landing Pages) (Bundles)", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "4528254028087296"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["4824662786441216"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "4571554143535104", "name": "US D2C Rotary Tool Finder Banner", "commitId": "4796770283159552", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {"google_analytics_4": {"is_using_gtm": "off"}}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "24474860013"], "audienceName": "Country = US + Language = en", "changes": null, "id": "6182557453123584", "integrationSettings": null, "variations": [{"id": "6402581782593536", "name": "Original", "actions": [{"viewId": "6297361257857024", "changes": [{"id": "2CF0C925-B974-430C-9133-E55B9F5E602D", "type": "custom_code", "value": function($){const exactMatch = [
  'https://www.dremel.com/us/en',
  'https://www.dremel.com/us/en/d2c/d2c-landingpage',
  'https://www.dremel.com/us/en/clearance',
  'https://www.dremel.com/us/en/rotary',
  'https://www.dremel.com/us/en/rotary/diy',
  'https://www.dremel.com/us/en/rotary/creative',
  'https://www.dremel.com/us/en/rotary/attachments',
  'https://www.dremel.com/us/en/pet-care',
  'https://www.dremel.com/us/en/home-solutions',
  'https://www.dremel.com/us/en/batteries',
  'https://www.dremel.com/us/en/mkt/blueprint/blueprint-landing-page',
  'https://www.dremel.com/us/en/mkt/blueprint/blueprint-portable-saw-station-cs12v-s1c',
  'https://www.dremel.com/us/en/blogs/blog-post-dremel-8240-rotary-tool-product-introduction',
  'https://www.dremel.com/us/en/p/8240-5bp-f0138240ad',
  'https://www.dremel.com/us/en/the-multiest-tool-in-the-world',
  'https://www.dremel.com/us/en/p/cs12v-s1c-f013cs12ac',
  'https://www.dremel.com/us/en/p/mm12v-s1-f013cm12aa',
  'https://www.dremel.com/us/en/p/8150-n-20-f0138150aa',
  'https://www.dremel.com/us/en/p/dd12v-s1-f013dd12aa',
  'https://www.dremel.com/us/en/p/4300-5-40-f0134300sc',
  'https://www.dremel.com/us/en/p/7760-pgkd-f0137760dc',
  'https://www.dremel.com/us/en/p/8250-5-f0138250aa',
  'https://www.dremel.com/us/en/p/hslm-01-f013lm01aa',
  'https://www.dremel.com/us/en/p/4000-2-32-f0134000fb',
  'https://www.dremel.com/us/en/p/ms20-01-f013ms20aa',
];
const substringMatch = [
  'https://www.dremel.com/us/en/product-categories',
  'https://www.dremel.com/us/en/search',
  'https://www.dremel.com/us/en/projects',
];

const currentUrl = window.location.href;

const cleanUrl = (url) => {
  const urlObj = new URL(url);
  return urlObj.origin + urlObj.pathname;
};

const cleanedCurrentUrl = cleanUrl(currentUrl);

const isBannerDismissedForSession = sessionStorage.getItem('dremelBannerDismissed');

const showPrimaryBanner = (exactMatch.includes(cleanedCurrentUrl) || substringMatch.some(url => currentUrl.startsWith(url))) && !isBannerDismissedForSession;

if (showPrimaryBanner && !document.getElementById('Tool-Finder-Wrapper')) {
    const bannerHtml = `
<div id="Tool-Finder-Wrapper" style="position: relative;">
    <a id="banner-click-area" href="https://www.dremel.com/us/en/rotary_tool_finder" aria-label=" Overwhelmed by options? We'll simplify your rotary tool choice. Find My Tool." title="Dremel Rotary Tool Finder" style="text-decoration: none; color: inherit; display: block;" >
        <div id="promotions-banner" class="banner">
            <div id="banner-content" style="max-width: 100vw !important; width: 100% !important;">
                <div class="banner-text" style="display: flex !important; align-items: center !important; justify-content: center !important; gap: 20px !important; flex-wrap: wrap !important; padding: 10px !important; box-sizing: border-box !important;">
                    <span style="padding-left: 20px; padding-right: 20px; flex: 0 1 auto !important; min-width: 200px !important; text-align: center !important;">
                        Overwhelmed by options? We'll simplify your rotary tool choice.
                    </span>
                    <div class="buttonBar" style="flex: 0 0 auto !important; padding: 0 !important; margin: 0 !important;">
                        <div class="header_button global_container__PbBFj ButtonBar_buttonBarWrapper__h7Ysj" style="padding: 0 !important; margin: 0 !important; white-space: nowrap !important; display: inline-block !important; vertical-align: middle !important;">
                            <div class="Link_container__4UWpV Link_link__CQ2j3 Link_primary__rXTiK Link_button___paEh Link_filled__ZZFRd Link_background-primary__oTJeI Link_text-white__qgIj5" style="height: 100% !important; width: auto !important; padding: 10px 20px !important; box-sizing: border-box !important; display: inline-flex !important; align-items: center !important; justify-content: center !important;">
                                <div style="padding: 0 !important; margin: 0 !important; white-space: nowrap !important;">
                                    <div style="white-space: nowrap !important;">
                                        Find My Tool
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </a>
    <button id="banner-close-button" aria-label="Dismiss banner" title="Dismiss" type="button"
            style="position: absolute; top: 5px; right: 5px; background: none; border: none; cursor: pointer; padding: 5px; line-height: 1; z-index: 100;">
        <svg class="Icon_icon__Y_3O7" height="13" width="13"><use xlink:href="/assets/images/icons/icons.svg#close"></use></svg>
    </button>
</div>
    `;
    const targetElement = document.querySelector('[class^="Header_navRow__"]');
    if (targetElement) {
        targetElement.insertAdjacentHTML("beforeend", bannerHtml);

        const bannerWrapper = document.getElementById('Tool-Finder-Wrapper');
        const bannerCloseButton = document.getElementById('banner-close-button');
        const hamburgerButton = document.querySelector('.MainNavigation_hamburgerMenuButton___7imr');

        if (bannerCloseButton) {
            bannerCloseButton.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                if (bannerWrapper) {
                    bannerWrapper.remove();
                }
                sessionStorage.setItem('dremelBannerDismissed', 'true');
            });
        }

        // --- HAMBURGER MENU INTERACTION ---
        if (hamburgerButton && bannerWrapper) {
            const handleHamburgerClick = () => {
                setTimeout(() => {
                    if (hamburgerButton.getAttribute('aria-expanded') === 'true') {
                        bannerWrapper.style.display = 'none';
                    } else {
                        if (!sessionStorage.getItem('dremelBannerDismissed')) {
                            bannerWrapper.style.display = '';
                        }
                    }
                }, 50);
            };

            hamburgerButton.addEventListener('click', handleHamburgerClick);

            const observer = new MutationObserver((mutationsList) => {
                for (const mutation of mutationsList) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'aria-expanded') {
                        handleHamburgerClick();
                    }
                }
            });

            observer.observe(hamburgerButton, { attributes: true });

            handleHamburgerClick();
        }
    }
}
}, "dependencies": []}, {"id": "E8B2955A-D01D-4B65-A240-9AA8C8D36C0A", "type": "append", "selector": "head", "value": "<style>.banner {\n  background: #EAEBEB;\n  transition: background-color 0.3s ease-in-out;\n}\n\n.banner:hover {\n  background-color: #D8D9DA;\n  text-decoration: underline;\n}\n\n.banner-text a:link {\n  color: #000;\n  background-color: transparent;\n  text-decoration: none;\n}\n.banner-text a:visited {\n  color: #000;\n  background-color: transparent;\n  text-decoration: none;\n}\n.banner-text a:hover {\n  color: #000;\n  background-color: transparent;\n  text-decoration: underline;\n}\n.banner-text a:active {\n  color: #000;\n  background-color: transparent;\n  text-decoration: underline;\n}\n\n.banner-text, .banner-close > span {\n  color: #000;\n}\n\n        \n.banner-text {\n  text-align: center;\n  flex-grow: 1;\n  line-height: 1.4;\n  font-family: 'Quicksand', sans-serif;\n  font-size: 18px;\n}\n        \n.banner-content {\n  padding: 10px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n}\n\n/* Mobile Phone */\n@media only screen and (max-width: 1100px) {\n    .banner, .banner-secondary {\n        width: 100%;\n    }\n    \n    .banner-content, .banner-content-secondary {\n        width: 90%;\n      margin: auto;\n    }\n  \n    .banner-text, .banner-text-secondary {\n        font-size: 16px;\n        padding: 5px;\n    } \n}\n\n.banner-secondary {\n  background: #EAEBEB;\n  width: 100%;\n}\n\n.banner-text-secondary {\n  color: #000;\n  text-align: center;\n  flex-grow: 1;\n  line-height: 1.4;\n  font-family: 'Quicksand', sans-serif;\n  font-size: 18px;\n  align-items: center;\n}\n\n.banner-content-secondary {\n  padding: 10px;\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n}\n\n.header_button {\n  width: 200px !important;\n}</style>", "dependencies": []}, {"css": {}, "dependencies": [], "attributes": {}, "type": "attribute", "id": "2B8BE16D-E027-4862-A186-81DCE47FFAB7", "selector": "#bann