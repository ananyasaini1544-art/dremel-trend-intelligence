        if (headlineWrapper) {
            categoryDivs.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
        if (headlineWrapperMobile) {
            categoryDivsMobile.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', promoTagHtml);
            });
        }
				if (galleryWrapper) {
                galleryWrapper.insertAdjacentHTML('beforeend', ribbonPromoHtml);
          			galleryWrapper.classList.add('cip-giftwrap-gallery');
        }
        }

        if (promoPrice) {
            if (priceDisplay) {
                priceDisplay.innerHTML = '';
                priceDisplay.insertAdjacentHTML('beforeend', promoPricingElement);
            }
            if (conversionBarPrice) {
                conversionBarPrice.innerHTML = promoPricingElementNav;
            }
        }

else if (couponMessage) { // Check for coupon message if no merch message
        if (conversionArea) {
            conversionArea.insertAdjacentHTML('beforebegin', couponBadgingElement);
        }
        if (headlineWrapper) {
            categoryDivs.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', couponTagHtml);
            });
        }
        if (headlineWrapperMobile) {
            categoryDivsMobile.forEach(categoryDiv => {
                categoryDiv.insertAdjacentHTML('afterend', couponTagHtml);
            });
        }
        if (galleryWrapper) {
          galleryWrapper.insertAdjacentHTML('beforeend', ribbonCouponHtml);
          galleryWrapper.classList.add('cip-giftwrap-gallery');
        }
    }

    // Add event listener for the coupon button
    document.getElementById('couponButton').addEventListener('click', function() {
        const iconContainer = document.getElementById('iconContainer');
        const couponText = document.getElementById('couponText');

        navigator.clipboard.writeText(couponCode).then(() => {
            iconContainer.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-check" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                </svg>
            `;
            couponText.textContent = `Code: Copied!`; // Update text to indicate copied status

            // Change the title for hover text
            this.title = 'Copied!';

            setTimeout(() => {
                iconContainer.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
                        <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                        <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                    </svg>
                `;
                couponText.textContent = `Code: ${couponCode}`; // Reset text to original
                this.title = 'Click to Copy';
            }, 2000);
        });
    });
  }
}}, {"id": "6BB9D21B-A5DD-40C5-99BB-A26A756A7A09", "type": "append", "dependencies": [], "name": "", "isOpalManaged": false, "selector": "head", "value": "<style>.coupon-button {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 15px 20px;\r\n    font-size: 16px;\r\n  \tfont-weight: bold;\r\n    border: none;\r\n    border-radius: 5px;\r\n    background-color: green;\r\n    color: white;\r\n    cursor: pointer;\r\n    transition: background-color 0.3s;\r\n  \tmargin: auto;\r\n}\r\n\r\n.coupon-button:hover {\r\n    background-color: #004D00;\r\n}\r\n\r\n.icon {\r\n    margin-right: 8px;\r\n    transition: opacity 0.3s;\r\n}\r\n\r\n\r\n.regular-price {\r\nfont-size: 0.85em;\r\nfont-weight: normal;\r\ncolor: #757575;\r\nmargin-left: 10px;\r\n}\r\n\r\n.regular-price-nav {\r\nfont-size: 0.45em;\r\nfont-weight: normal;\r\ncolor: #C4C4C4;\r\nmargin-left: 10px;\r\n}\r\n\r\n.promo-price {\r\nfont-size: 32px;\r\nfont-weight: 700;\r\n}\r\n\r\n.regular-price-nav {\r\nfont-size: 12px;\r\nfont-weight: normal;\r\n}\r\n\r\n\r\n@media (min-width: 992px) {\r\n    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 19px;\r\n\t}\r\n}\r\n\t\r\n@media (min-width: 768px) and (max-width: 991px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 9px;\r\n\t}\r\n}\r\n\r\n@media (max-width: 767px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 8px;\r\n\t}\r\n}\r\n\r\n\r\n.ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV :nth-child(2) {\r\n  display: block;\r\n}\r\n\r\n@media (max-width: 450px) {\r\n    .ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV {\r\n  display: initial;\r\n    }\r\n}\r\n\r\n\r\n.coupon-badging {\t\r\n  background-color: green;\r\n  color: #FFFFFF;\r\n  font-size: 16px; \r\n  font-weight: bold;\r\n  padding: 10px;\r\n  text-align: center;\r\n  width: fit-content;\r\n  height: fit-content;\r\n  margin: auto;\r\n}\r\n\r\n.promo-badging {\t\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  font-size: 16px; \r\n  font-weight: bold;\r\n  padding: 10px;\r\n  text-align: center;\r\n  width: fit-content;\r\n  height: fit-content;\r\n  margin: auto;\r\n}\r\n\r\n.ProductDisplayPrice_priceAndVat__GpiGU {\r\n  display: flex;\r\n  flex-direction: column;\r\n  text-align: right;\r\n}\r\n\r\n\r\n/* Shared layout helpers */\r\n.cip-giftwrap-stage-headline,\r\n.cip-giftwrap-categories {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media(max-width: 991px) {\r\n  .cip-giftwrap-stage-headline[class*=Mobile],\r\n  .cip-giftwrap-stage-headline[class*=Mobile] .cip-giftwrap-categories {\r\n  \tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n@media(min-width: 992px) {\r\n  .cip-giftwrap-stage-headline:not([class*=Mobile]),\r\n  .cip-giftwrap-stage-headline:not([class*=Mobile]) .cip-giftwrap-categories {\r\n  \tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n.cip-giftwrap-gallery {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding-top:10px;\r\n}\r\n\r\n/* Base label class (minimal defaults) */\r\n.cip-giftwrap-label {\r\n  background: #C00000!important;\r\n  color: #FFFFFF;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Category pill\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  padding-right: 0.8em;\r\n  padding-left: 0.2em;\r\n  border-radius: 99em;\r\n}\r\n\r\n.cip-giftwrap-label--pill img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Image ribbon\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--ribbon {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  transform: translate(24%, 80%) rotate(45deg);\r\n  z-index: 5;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* Ribbon triangles */\r\n.cip-giftwrap-ribbon-triangle {\r\n  display:none!important;\r\n  width: 0;\r\n  height: 0;\r\n  border-bottom: 11px solid rgb(133, 0, 0);\r\n  border-left: 11px solid transparent;\r\n  border-right: 11px solid transparent;\r\n  z-index: -1;\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--left {\r\n  transform: rotate(-45deg) translate(-62%, 140%);\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--right {\r\n  transform: rotate(45deg) translate(30%, 200%);\r\n}\r\n\r\n/* Ribbon bar */\r\n.cip-promo-ribbon-bar {\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-coupon-ribbon-bar {\r\n  background-color: green;\r\n  color: #FFFFFF;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 4px 40px;\r\n  font-size: 12px;\r\n}\r\n\r\n.cip-promo-ribbon-bar img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Icon (round, unfolding text)\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--icon {\r\n  position: absolute;\r\n  top: 16px;\r\n  left: 16px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  background-color: #C00000;\r\n  color: #FFFFFF;\r\n  border-radius: 9999px;\r\n  padding: 8px;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  z-index: 5;\r\n  transition: padding-right 0.2s ease;\r\n}\r\n\r\n.cip-giftwrap-label--icon img {\r\n  height: 24px;\r\n  display: inline-block;\r\n}\r\n@media (max-width:991px) {\r\n  .cip-giftwrap-label--icon {\r\n  \ttop:0;\r\n    left:0;\r\n  }\r\n}\r\n@media (min-width:992px) {\r\n  /* Text span: hidden by default */\r\n  .cip-giftwrap-label__text {\r\n    white-space: nowrap;\r\n    margin-left: 0;\r\n    opacity: 0;\r\n    max-width: 0;\r\n    overflow: hidden;\r\n    transition: opacity 0.2s ease, max-width 0.2s ease, margin-left 0.2s ease;\r\n  }\r\n\r\n  /* When expanded (hover) */\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded {\r\n    padding-right: 16px;\r\n  }\r\n\r\n  .cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded .cip-giftwrap-label__text {\r\n    margin-left: 8px;\r\n    opacity: 1;\r\n    max-width: 200px;\r\n  }\r\n}</style>"}]}]}, {"id": "5677279750127616", "name": "Banner and Tag", "actions": [{"viewId": "5596485002199040", "changes": [{"id": "F999765E-148B-4864-99F0-B1C9695F4FA1", "type": "custom_code", "dependencies": [], "name": "", "isOpalManaged": false, "value": function($){// PRODUCT INPUT MAPPING, Copy/Paste products Below to other Variation to Update Prices/Promos/Coupons
const products = [
    // Batteries
