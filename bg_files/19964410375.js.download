          { model: 'hssc-01-f013sc01aa', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
  	      { model: 'hssc-02-f013sc01ab', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
	      { model: 'pc360-5-2615p418sd', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
	      { model: 'pc501-2615p500ac', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
    
    // Accessory Kits
          { model: '730-02-walmart-26150730ab', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
          { model: '736-01-26150735ab', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
  				{ model: 'ez727-01-2615e727aa', merchandising: 'Save $10', slashedPrice: '29.99', promoPrice: '19.99', coupon: '', code: ''},
	
	  // Pet Care
	      { model: '7350-petd-f0137350dd', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
	      { model: '7760-pgkd-f0137760dc', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', code: ''},
