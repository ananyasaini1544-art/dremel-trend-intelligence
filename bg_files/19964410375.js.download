    { model: 'HSSC-02', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'PC360-5', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'PC501', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Accessory Kits
    { model: '730-02', merchandising: 'Save $5', slashedPrice: '19.99', promoPrice: '14.99', coupon: '', stockOut: ''},
    { model: '736-01', merchandising: 'Save $5', slashedPrice: '19.99', promoPrice: '14.99', coupon: '', stockOut: ''},
    { model: 'EZ727-01', merchandising: 'Save $10', slashedPrice: '29.99', promoPrice: '19.99', coupon: '', stockOut: ''},
    
    // Attachments
    { model: '225-02', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
  
    // Pet Care
    { model: '7350-PETD', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '7760-PGKD', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '738-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'AT02-PGK', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: '',},
    { model: '416HP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'SD60-PGK', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Blueprint
    { model: 'DD12V-S1', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS12V-S1C', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'Multi-Tool', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS500', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: 'CS600', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    
    // Pumpkin
    { model: '7350-PMP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '2050-PMP', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
    { model: '737-01', merchandising: '', slashedPrice: '', promoPrice: '', coupon: '', stockOut: ''},
];
// Copy/Paste products Above to other Variation to Update Prices/Promos/Stock

// Merchandising Placement
const teaserDivs = document.querySelectorAll('[class^="StandardTeaserRow_teaser"]');
teaserDivs.forEach(div => {
    const messageSpan = div.querySelector('[class^="RichText_container"]');
    const imageAnchor = div.querySelector('[class^="StandardTeaserRow_imageContainer"]');
    let existingPrice = div.querySelector('strong'); 
    let hasRelevantCta = false;
    if (messageSpan && imageAnchor && existingPrice) {
        let priceModifiedForTeaser = false; 
        
        products.forEach(product => {
            const modelNumber = product.model;
            if (messageSpan.innerHTML && messageSpan.innerHTML.includes(modelNumber) && !priceModifiedForTeaser) {
                const promoPrice = product.promoPrice;
                const slashedPrice = product.slashedPrice;
                const merchMessage = product.merchandising;
                const couponMessage = product.coupon;
                const stockOutMessage = product.stockOut;

                if (stockOutMessage) {
                    if (!imageAnchor.querySelector('.stock-out-message')) {
                        imageAnchor.insertAdjacentHTML('afterbegin', `<div class="stock-out-message badging-left">${stockOutMessage}</div>`);
                        imageAnchor.id = "Stock-Out";
                    }
                } else {
                    const parentOfPrice = existingPrice.parentElement;
                    const listPriceAlreadyExists = parentOfPrice.querySelector('.list-price');

                    if (promoPrice && slashedPrice && !listPriceAlreadyExists) {
                        if (!imageAnchor.querySelector('.promo-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="promo-badging badging-left">${merchMessage}</div>`);
                            imageAnchor.id = "Promo-Savings";
                        }
                        const priceHTML = `<strong>$${promoPrice}</strong><span class="list-price">List Price: <s>$${slashedPrice}</s></span>`;
                        
                        existingPrice.remove();
                        parentOfPrice.insertAdjacentHTML('beforeend', priceHTML);
                        priceModifiedForTeaser = true; 

                    } else if (couponMessage) {
                        if (!imageAnchor.querySelector('.coupon-badging')) {
                            imageAnchor.insertAdjacentHTML('afterbegin', `<div class="coupon-badging badging-left">${couponMessage}</div>`);
                            imageAnchor.id = "Coupon-Savings";
                        }
                    }
                }
            }
        });
        
        const ctaSpan = div.querySelector('.Link_container__4UWpV.Link_link__CQ2j3.Link_primary__rXTiK');
        if (ctaSpan) {
            const ctaText = ctaSpan.textContent.trim();
            if (ctaText === "Shop now" || ctaText === "Shop Now") {
                ctaSpan.classList.add('Link_button___paEh', 'Link_filled__ZZFRd', 'Link_background-primary__oTJeI', 'Link_text-white__qgIj5', 'Link_text-bold__PKe81', 'Link_size_full');
                hasRelevantCta = true;
            } 
            else if (
                ctaText === "Explore Creative" ||
                ctaText === "Explore Pet" ||
                ctaText === "Explore DIY" ||
                ctaText === "Attachments"
            ) {
                ctaSpan.classList.add('Link_button___paEh', 'Link_filled__ZZFRd', 'Link_background-primary__oTJeI', 'Link_text-white__qgIj5', 'Link_text-bold__PKe81', 'Link_size_full');
                hasRelevantCta = true;
            }
        }
    }
    if (hasRelevantCta) {
        div.classList.add('has-shop-or-category-cta');
    }
});

const divs = document.querySelectorAll('.global_container__PbBFj.ButtonBar_buttonBarWrapper__h7Ysj .Link_container__4UWpV.Link_link__CQ2j3.Link_primary__rXTiK.Link_button___paEh.Link_filled__ZZFRd.Link_background-primary__oTJeI.Link_text-white__qgIj5.Link_text-bold__PKe81');
divs.forEach(div => {
    div.classList.remove('Link_filled__ZZFRd', 'Link_background-primary__oTJeI', 'Link_text-white__qgIj5', 'Link_text-bold__PKe81');
    div.classList.add('Link_dark__9jkFQ', 'Link_button___paEh');
});
}, "dependencies": []}, {"id": "8f168dba0cd64ef99640281d52786e3b", "type": "append", "selector": "head", "value": "<style>.promo-price{\n  font-weight: bold;\n}\n\n.list-price{\n  font-size: .90rem;\n  color: #4D4D4D;\n  margin-left: 1.0rem;\n}\n\n.badging-left {\n  font-size: 16px;\n  font-weight: bold;\n  text-align: center;\n  width: fit-content;\n  padding: 20px;\n  display: inline-flex;\n  align-items: center;\n  position: absolute;\n  line-height: 12px;\n  border-radius: 999em;\n  transform: translateX(-12px) translateY(-30%);\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n.promo-badging {\n  background-color: #C00000;\n  color: #FFFFFF;\n}\n\n.coupon-badging {\n  background-color: green;\n  color: #FFFFFF;\n}\n\n.stock-out-message {\n  background-color: #757575;\n  color: #FFFFFF;\n}\n\n@media (max-width: 1020px) and (min-width: 768px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n@media (max-width: 360px) {\n    .badging-left {\n        padding: 12.5px;\n    }\n}\n\n.promo-badging:hover {\n    background-color: #850000;\n}\n\n.coupon-badging:hover {\n    background-color: #004D00;\n}\n\n\n.Link_size_full {\n\t\t display: flex;\njustify-content: center;\nalign-items: center;\nwidth: 100%;\nmargin-bottom: 10px; \n}\n\n@media (max-width: 768px) and (min-width: 360px) {\n    .secondary-cta-resize {\n        width: 45%;\n  \t}\n}\n\n@media (max-width: 767px) {\n\t.Spacer_spacer__ktR9d.Spacer_spacer--small__E03ru {\n\t\tpadding-top: 25px;\n\t}\n}</style>", "dependencies": []}, {"css": {}, "dependencies": [], "attributes": {"style": "border: #C7C7C7 solid 1px;\npadding-bottom: 12.5px;\n"}, "type": "attribute", "id": "4e4c36e55aae4ed597502e0516598328", "selector": "[class^=\"StandardTeaserRow_teaser\"].has-shop-or-category-cta"}, {"css": {}, "dependencies": [], "attributes": {"style": "Gap: 10px;"}, "type": "attribute", "id": "3b85d28aa2e2403d88ef19663b9cc9d3", "selector": "[class^=\"StandardTeaserRow_teaserGroup__\"]"}, {"css": {}, "dependencies": [], "attributes": {"style": "width: 45%"}, "type": "attribute", "id": "dd7b07f91d614bdfb154d2cec50c1532", "selector": "[class^=\"global_container__\"][class*=\"ButtonBar_buttonBarWrapper__\"]"}]}]}], "weightDistributions": [{"entityId": "4979880408907776", "endOfRange": 5000}, {"entityId": "4967250688475136", "endOfRange": 10000}], "name": "US D2C Merchandising (Landing Pages) (Borders & Buttons)", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "5471378380423168"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["4824662786441216", "5181362081103872"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "5486325235712000", "name": "US D2C Merchandising (PDPs) (Bundles)", "commitId": "5120206285045760", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {"google_analytics_4": {"is_using_gtm": "on"}}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "26314140820"], "audienceName": "Country = US", "changes": null, "id": "4936620961431552", "integrationSettings": null, "variations": [{"id": "5321711554396160", "name": "Original", "actions": [{"viewId": "5596485002199040", "changes": [{"id": "ca72e4572ce3430f9e85e8038b2de2f8", "type": "append", "selector": "head", "value": "<style>/* ------------------------------------\r\n * MERCHANDISING & BUNDLE STYLES\r\n * ---------------------------------- */\r\n.regular-price {\r\n\tfont-size: 0.85em;\r\n\tfont-weight: normal;\r\n\tcolor: #757575;\r\n\tmargin-left: 10px;\r\n}\r\n\r\n.regular-price-nav {\r\n\tfont-size: 0.45em;\r\n\tfont-weight: normal;\r\n\tcolor: #C4C4C4;\r\n\tmargin-left: 10px;\r\n}\r\n\r\n.promo-price {\r\n\tfont-size: 32px;\r\n\tfont-weight: 700;\r\n}\r\n\r\n.regular-price-nav {\r\n\tfont-size: 12px;\r\n\tfont-weight: normal;\r\n}\r\n\r\n.list-price{\r\n\tfont-size: .90rem;\r\n\tcolor: #4D4D4D;\r\n\tmargin-left: 1.0rem;\r\n}\r\n\r\n@media (min-width: 992px) {\r\n    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 19px;\r\n\t}\r\n}\r\n\t\r\n@media (min-width: 768px) and (max-width: 991px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 9px;\r\n\t}\r\n}\r\n\r\n@media (max-width: 767px) {\r\n\t    .ConversionArea_container__7XX6g\r\n\t.ConversionArea_adpGrid__TJfRV\r\n\t.ConversionArea_freeDelivery__AYur_\t{\r\n\t\tpadding-bottom: 8px;\r\n\t}\r\n}\r\n\r\n.ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV :nth-child(2) {\r\n\tdisplay: block;\r\n}\r\n\r\n@media (max-width: 450px) {\r\n\t.ConversionArea_container__7XX6g .ConversionArea_adpGrid__TJfRV {\r\n\t\tdisplay: initial;\r\n\t}\r\n}\r\n\r\n.badging-left {\r\n\tfont-size: 16px;\r\n\tfont-weight: bold;\r\n\ttext-align: center;\r\n\twidth: fit-content;\r\n\tpadding: 20px;\r\n\tdisplay: inline-flex;\r\n\talign-items: center;\r\n\tposition: absolute;\r\n\tline-height: 12px;\r\n\tborder-radius: 999em;\r\n\ttransform: translateX(-12px) translateY(-30%);\r\n\ttransition: background-color 0.3s ease, color 0.3s ease;\r\n}\r\n\r\n.promo-badging {\r\n\tbackground-color: #C00000;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n@media (max-width: 1020px) and (min-width: 768px) {\r\n    .badging-left {\r\n        padding: 12.5px;\r\n    }\r\n}\r\n\r\n@media (max-width: 360px) {\r\n\t.badging-left {\r\n\t\tpadding: 12.5px;\r\n\t}\r\n}\r\n\r\n.promo-badging:hover {\r\n\tbackground-color: #850000;\r\n}\r\n\r\n.ProductDisplayPrice_priceAndVat__GpiGU {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\ttext-align: right;\r\n}\r\n\r\n.Link_size_full {\r\n\tdisplay: flex;\r\n\tjustify-content: center;\r\n\talign-items: center;\r\n\twidth: 100%;\r\n\tmargin-bottom: 10px; \r\n}\r\n\r\n/* Shared layout helpers */\r\n.cip-giftwrap-stage-headline,\r\n.cip-giftwrap-categories {\r\n\tflex-wrap: wrap;\r\n}\r\n\r\n@media(max-width: 991px) {\r\n\t.cip-giftwrap-stage-headline[class*=Mobile],\r\n\t.cip-giftwrap-stage-headline[class*=Mobile] .cip-giftwrap-categories {\r\n\t\tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n@media(min-width: 992px) {\r\n\t.cip-giftwrap-stage-headline:not([class*=Mobile]),\r\n\t.cip-giftwrap-stage-headline:not([class*=Mobile]) .cip-giftwrap-categories {\r\n\t\tdisplay: inline-flex;\r\n\t}\r\n}\r\n\r\n.cip-giftwrap-gallery {\r\n\tposition: relative;\r\n\toverflow: hidden;\r\n\tpadding-top:10px;\r\n}\r\n\r\n/* Base label class (minimal defaults) */\r\n.cip-giftwrap-label {\r\n\tbackground: #C00000!important;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Category pill\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--pill {\r\n\tdisplay: inline-flex;\r\n\talign-items: center;\r\n\tgap: 4px;\r\n\tbackground-color: #C00000;\r\n\tcolor: #FFFFFF;\r\n\tpadding-right: 0.8em;\r\n\tpadding-left: 0.2em;\r\n\tborder-radius: 99em;\r\n}\r\n\r\n.cip-giftwrap-label--pill img {\r\n\theight: 24px;\r\n\tdisplay: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Image ribbon\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--ribbon {\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\tright: 0;\r\n\ttransform: translate(24%, 80%) rotate(45deg);\r\n\tz-index: 5;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n}\r\n\r\n/* Ribbon triangles */\r\n.cip-giftwrap-ribbon-triangle {\r\n\tdisplay:none!important;\r\n\twidth: 0;\r\n\theight: 0;\r\n\tborder-bottom: 11px solid rgb(133, 0, 0);\r\n\tborder-left: 11px solid transparent;\r\n\tborder-right: 11px solid transparent;\r\n\tz-index: -1;\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--left {\r\n\ttransform: rotate(-45deg) translate(-62%, 140%);\r\n}\r\n\r\n.cip-giftwrap-ribbon-triangle--right {\r\n\ttransform: rotate(45deg) translate(30%, 200%);\r\n}\r\n\r\n/* Ribbon bar */\r\n.cip-promo-ribbon-bar {\r\n\tbackground-color: #C00000;\r\n\tcolor: #FFFFFF;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n\tgap: 4px;\r\n\tpadding: 4px 40px;\r\n\tfont-size: 12px;\r\n}\r\n\r\n.cip-coupon-ribbon-bar {\r\n\tbackground-color: green;\r\n\tcolor: #FFFFFF;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n\tgap: 4px;\r\n\tpadding: 4px 40px;\r\n\tfont-size: 12px;\r\n}\r\n\r\n.cip-promo-ribbon-bar img {\r\n\theight: 24px;\r\n\tdisplay: inline-block;\r\n}\r\n\r\n/* ------------------------------------\r\n * Variant: Icon (round, unfolding text)\r\n * ---------------------------------- */\r\n.cip-giftwrap-label--icon {\r\n\tposition: absolute;\r\n\ttop: 16px;\r\n\tleft: 16px;\r\n\tdisplay: inline-flex;\r\n\talign-items: center;\r\n\tbackground-color: #C00000;\r\n\tcolor: #FFFFFF;\r\n\tborder-radius: 9999px;\r\n\tpadding: 8px;\r\n\toverflow: hidden;\r\n\tcursor: pointer;\r\n\tz-index: 5;\r\n\ttransition: padding-right 0.2s ease;\r\n}\r\n\r\n.cip-giftwrap-label--icon img {\r\n\theight: 24px;\r\n\tdisplay: inline-block;\r\n}\r\n\r\n@media (max-width:991px) {\r\n\t.cip-giftwrap-label--icon {\r\n\t\ttop:0;\r\n\t\tleft:0;\r\n\t}\r\n}\r\n\r\n@media (min-width:992px) {\r\n  /* Text span: hidden by default */\r\n\t.cip-giftwrap-label__text {\r\n\t\twhite-space: nowrap;\r\n\t\tmargin-left: 0;\r\n\t\topacity: 0;\r\n\t\tmax-width: 0;\r\n\t\toverflow: hidden;\r\n\t\ttransition: opacity 0.2s ease, max-width 0.2s ease, margin-left 0.2s ease;\r\n\t}\r\n\r\n  /* When expanded (hover) */\r\n\t.cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded {\r\n\t\tpadding-right: 16px;\r\n\t}\r\n\r\n\t.cip-giftwrap-label--icon.cip-giftwrap-label--icon-expanded .cip-giftwrap-label__text {\r\n\t\tmargin-left: 8px;\r\n\t\topacity: 1;\r\n\t\tmax-width: 200px;\r\n\t}\r\n}\r\n\r\n/* ------------------------------------\r\n * JUMBOTRON STYLES\r\n * ---------------------------------- */\r\n .CatalogProduct_belowstageContainer__Xjcf8 {\r\n\tposition: relative;\r\n}\r\n\r\n.static-hero {\r\n\tposition: relative;\r\n\twidth: 100%;\r\n\tmin-height: 400px;\r\n\taspect-ratio: 16 / 7;\r\n\tbackground-color: #e9e9e9;\r\n\toverflow: hidden;\r\n}\r\n\r\n@media (max-width: 767px) {\r\n\t.static-hero {\r\n\t\taspect-ratio: unset;\r\n\t}\r\n}\r\n\r\n.static-hero__background-image {\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\tleft: 0;\r\n\twidth: 100%;\r\n\theight: 100%;\r\n\tz-index: 1;\r\n}\r\n\r\n.static-hero__background-image img {\r\n\twidth: 100%;\r\n\theight: 100%;\r\n\tobject-fit: cover;\r\n\tfont-family: 'object-fit: cover;';\r\n}\r\n\r\n.static-hero__content-wrapper {\r\n\tposition: relative;\r\n\tz-index: 2;\r\n\theight: 100%;\r\n\tmax-width: 1400px;\r\n\tmargin: 0 auto;\r\n\tpadding: 2rem;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: flex-start;\r\n}\r\n\r\n.static-hero__text-box {\r\n\tbackground-color: white;\r\n\tpadding: 2.5rem;\r\n\tborder-radius: 4px;\r\n\tbox-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);\r\n\twidth: 100%;\r\n\tmax-width: 450px;\r\n}\r\n\r\n@media (min-width: 992px) {\r\n\t.static-hero__text-box {\r\n\t\twidth: 35%;\r\n\t}\r\n}\r\n\r\n.static-hero__title {\r\n\tfont-size: 2.25rem;\r\n\tfont-weight: 700;\r\n\tcolor: #111;\r\n\tmargin: 0 0 1rem 0;\r\n}\r\n\r\n.static-hero__description {\r\n\tfont-size: 1.1rem;\r\n\tline-height: 1.6;\r\n\tcolor: #333;\r\n\tmargin: 0;\r\n}\r\n\r\n.bundle-section .StandardTeaserRow_teaser__5tRAe {\r\n\tmax-width: 550px;\r\n\tmargin-left: auto;\r\n\tmargin-right: auto;\r\n}\r\n\r\n.bundle-section .StandardTeaserRow_teaser__5tRAe ~ .StandardTeaserRow_teaser__5tRAe {\r\n\tmargin-left: unset;\r\n\tmargin-right: unset;\r\n}</style>", "dependencies": [], "name": "", "isOpalManaged": false}, {"id": "549970a670f64e7a9cc7abfa4d8d045a", "type": "custom_code", "value": function($){const blueprintProducts = [
    { model: 'cs12v-s1c-f013cs12ac', bpaa: 'true', bpab: 'true' },
    { model: 'dd12v-s1-f013dd12aa', bpaa: 'true', bpab: 'true' },
    { model: 'mm12v-s1-f013cm12aa', bpaa: 'false', bpab: 'true' },
];

const bundleProducts = [
    { model: 'bp12aa-f013bp12aa', merchandising: 'Save $48', slashedPrice: '248.00', promoPrice: '199.99' },
    { model: 'bp12ab-f0138p12ab', merchandising: 'Save $88', slashedPrice: '387.99', promoPrice: '299.99' },
];

function handleBlueprintProductLogic(productData) {
    const bpaaBundleData = bundleProducts.find(p => p.model === 'bp12aa-f013bp12aa');
    const bpabBundleData = bundleProducts.find(p => p.model === 'bp12ab-f0138p12ab');

    const bundleSection = `<section class="StageHeadline_headlineWrapper__4mmFD StageHeadline_headlineWrapper--primary__2TgBH StageHeadline_headlineWrapper--center__x5ELW"><div class="global_container__PbBFj global_withPadding__W3hN0"><div class="StageHeadline_container__HKa3T"><h1 class="StageHeadline_headline__aPsCO" style="text-align: center;">The Perfect Pairing for Your Projects</h1><div class="StageHeadline_introtext__BpVG9"><span class="RichText_container__vRFfH"><p style="text-align: center;">We’ve done the work of putting the perfect team of tools together for you. These all-in-one kits are the simplest way to expand your workshop and save. Get everything you need to tackle projects with confidence.</p></span></div></div></div></section><div class="standardTeaserRow"><div class="StandardTeaserRow_container__PP07d global_containerFluid__gL4K8 global_withPadding__W3hN0"><div class="StandardTeaserRow_teaserGroup__9IwHp has-shop-or-category-cta bundle-section" style="gap: 10px;"></div></div></div>`;
    
